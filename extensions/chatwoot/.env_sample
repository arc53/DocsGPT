# DocsGPT API base URL, e.g. https://gptcloud.arc53.com or http://localhost:7091
docsgpt_url=<docsgpt_api_url>
# API key of a published DocsGPT agent (the agent's Access Details), not an LLM provider key
docsgpt_key=<agent_api_key>
# Chatwoot base URL, e.g. https://app.chatwoot.com
chatwoot_url=<chatwoot_url>
# Access Token from your Chatwoot profile settings
chatwoot_token=<chatwoot_access_token>
# Secret of the Chatwoot webhook that points at this bridge
chatwoot_webhook_secret=<chatwoot_webhook_secret>
# Optional: answer only in this Chatwoot account / only conversations assigned to this agent
# account_id=1
# assignee_id=1
